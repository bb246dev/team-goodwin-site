# Add these values in cPanel's Node.js application Environment variables interface.
# Do not upload a populated environment file.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
# Decimal Strava webhook subscription ID, stored as a JSON string in private config.
STRAVA_WEBHOOK_SUBSCRIPTION_ID=
# Random administrator password of at least 32 characters. Basic username: strava.
STRAVA_ADMIN_TOKEN=
# Standard base64 for exactly 32 random bytes. Keep stable while encrypted credentials exist.
STRAVA_TOKEN_ENCRYPTION_KEY=
# HAPN API #2 values are server-only and optional until the RV feed is activated.
HAPN_CLIENT_ID=
HAPN_CLIENT_SECRET=
HAPN_DEVICE_IMEI=
HAPN_STALE_AFTER_SECONDS=900
HAPN_RETENTION_SECONDS=21600
HAPN_PUBLIC_COORDINATE_DECIMALS=3
