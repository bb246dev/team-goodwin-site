# Add these values in cPanel's Node.js application Environment variables interface.
# Do not upload a populated environment file.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
# Random administrator password of at least 32 characters. Basic username: strava.
STRAVA_ADMIN_TOKEN=
# Standard base64 for exactly 32 random bytes. Keep stable while encrypted credentials exist.
STRAVA_TOKEN_ENCRYPTION_KEY=
