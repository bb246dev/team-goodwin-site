{
  "name": "goodwin-website",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm run build:site && npm run build:cpanel",
    "build:site": "node build-offline.mjs",
    "build:cpanel": "node scripts/build-strava-cpanel.mjs",
    "build:tracking-preview": "node tracking-preview/build.mjs",
    "build:portfolio": "node portfolio/mission-america-2026/build.mjs",
    "verify:portfolio": "node portfolio/mission-america-2026/verify.mjs",
    "test:portfolio": "node --test tests/portfolio-archive.test.mjs",
    "check:cpanel": "node scripts/check-strava-cpanel-package.mjs",
    "test:deploy": "node --test tests/deploy-tooling.test.mjs",
    "test:tracking-preview": "node tracking-preview/build.mjs && node --test tracking-preview/tracking-preview.test.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
